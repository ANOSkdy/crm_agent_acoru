{
  "name": "crm_agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mail": "node scripts/bulk-mail/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:billing": "node --no-wasm-tier-up --no-liftoff --import tsx --test --test-concurrency=1 tests/billing.test.ts tests/crm-billing.test.ts tests/billing-resend.test.mjs",
    "test:billing:browser": "tsx scripts/billing/verify-browser.mts",
    "test:billing:crm-browser": "tsx scripts/billing/verify-crm-browser.mts",
    "test:auth": "node --conditions=react-server --no-wasm-tier-up --import tsx --test tests/mfa.test.ts",
    "test:auth:local": "node --import tsx --test tests/local-auth.test.ts",
    "test:auth:local-browser": "node --import ./tests/helpers/server-only.mjs --no-wasm-tier-up --no-liftoff --import tsx scripts/bulk-mail/verify-browser.mts --local-auth",
    "test:auth:browser": "tsx scripts/auth/verify-browser.mts",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "test:crm-security": "node --import ./tests/helpers/server-only.mjs --no-wasm-tier-up --no-liftoff --import tsx --test --test-concurrency=1 tests/crm-security.test.ts",
    "test:bulk-mail": "node --import ./tests/helpers/server-only.mjs --no-wasm-tier-up --no-liftoff --import tsx --test --test-concurrency=1 tests/bulk-mail.test.ts",
    "test:bulk-mail:browser": "node --import ./tests/helpers/server-only.mjs --no-wasm-tier-up --no-liftoff --import tsx scripts/bulk-mail/verify-browser.mts",
    "test:raw": "node --import ./tests/helpers/server-only.mjs --no-wasm-tier-up --no-liftoff --import tsx --test --test-concurrency=1 tests/raw-*.test.ts",
    "raw:sync": "tsx scripts/raw/sync.ts",
    "test:tasks": "node --import ./tests/helpers/server-only.mjs --no-wasm-tier-up --no-liftoff --import tsx --test --test-concurrency=1 tests/tasks.test.ts",
    "test:tasks:browser": "node --import ./tests/helpers/server-only.mjs --no-wasm-tier-up --no-liftoff --import tsx scripts/tasks/verify-browser.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "dotenv": "^17.4.2",
    "next": "16.2.9",
    "otpauth": "9.5.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agent-browser": "^0.38.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
