DATABASE_URL=postgres://user:password@host/dbname
APP_URL=http://localhost:3000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Billing: keep both false until the owner approves real recipient registration and sending.
BILLING_LIVE_SEND_ENABLED=false
BILLING_ALLOW_REAL_RECIPIENTS=false
RESEND_API_KEY=
CRON_SECRET=

# Required for user-specific OTP (32 random bytes, base64). Separate keys per environment.
# Never prefix with NEXT_PUBLIC_ or commit the real value.
MFA_ENCRYPTION_KEY=
OTP_USER_ID=

# Development only, loopback hosts only. Never enables on production/preview.
LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_KEY=

# RAW business data: enable after migrations 007-011
RAW_INGEST_ENABLED=false
RAW_EXTRACTION_ENABLED=false
RAW_APPLY_ENABLED=false
RAW_SYNC_ENABLED=false

# Local bulk mail rehearsal. Bulk delivery remains simulated.
BULK_MAIL_LOCAL_ENABLED=false
BULK_MAIL_LOCAL_DIR=.local-test/bulk-mail

# Separate single-recipient test, sent only by explicit manual confirmation.
# Use a development Resend sending key; never use NEXT_PUBLIC_ for this key.
BULK_MAIL_TEST_ENABLED=false
BULK_MAIL_TEST_TO=
BULK_MAIL_TEST_FROM=support@acoru.jp
BULK_MAIL_TEST_API_KEY=

# Production only: persistent mail tables and manual sending. No startup/cron sends.
BULK_MAIL_ENABLED=false
BULK_MAIL_LIVE_SEND_ENABLED=false
BULK_MAIL_FROM=support@acoru.jp
BULK_MAIL_ORIGIN=
